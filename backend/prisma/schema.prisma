//
// StudentLeave:
//   approvals             StudentLeaveApproval[]
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// HR LEAVE RULES & SALARY CALCULATOR — Phase 2
// ─────────────────────────────────────────────────────────────

model LeaveRulePolicy {
  id         String   @id @default(uuid())
  name       String // "Teaching Staff 2025-26"
  session_id String
  staff_type String // TEACHING | NON_TEACHING | ALL
  dept_id    String? // null = all departments
  is_active  Boolean  @default(true)
  created_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session AcademicSession     @relation(fields: [session_id], references: [id])
  rules   LeaveRule[]
  quotas  FacultyLeaveQuota[]

  @@index([session_id])
}

model LeaveRule {
  id              String   @id @default(uuid())
  policy_id       String
  leave_type      String // CL | EL | ML | SL | LWP | SLOT | RESTRICTED
  label           String // "Casual Leave", "Earned Leave"
  max_per_session Int // max leaves allowed in full academic session
  max_consecutive Int      @default(3) // max continuous days
  max_in_month    Int      @default(2) // max in one calendar month
  carry_forward   Boolean  @default(false)
  encashable      Boolean  @default(false)
  requires_cover  Boolean  @default(true) // must assign cover faculty
  min_notice_days Int      @default(1)
  applies_to      String   @default("ALL") // TEACHING | NON_TEACHING | ALL
  is_slot_based   Boolean  @default(false) // winter/summer break slots
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  policy LeaveRulePolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@unique([policy_id, leave_type])
  @@index([policy_id])
}

model LeaveSlot {
  id         String   @id @default(uuid())
  name       String // "Winter Break 2025", "Summer Break 2026"
  slot_type  String // WINTER | SUMMER | SPECIAL
  session_id String
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  max_leaves Int // max leave days faculty can take in this slot
  staff_type String   @default("ALL")
  dept_id    String?
  is_active  Boolean  @default(true)
  created_by String?
  createdAt  DateTime @default(now())

  session AcademicSession @relation(fields: [session_id], references: [id])

  @@index([session_id])
}

model SalaryCycle {
  id           String    @id @default(uuid())
  session_id   String
  month        Int
  year         Int
  total_days   Int // HR sets: 28/30/31 or custom range days
  working_days Int // after removing sundays/holidays
  from_date    DateTime  @db.Date
  to_date      DateTime  @db.Date
  is_locked    Boolean   @default(false)
  locked_by    String?
  locked_at    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session     AcademicSession @relation(fields: [session_id], references: [id])
  salarySlips SalarySlip[]

  @@unique([session_id, month, year])
  @@index([session_id])
}

model FacultyLeaveQuota {
  id              String   @id @default(uuid())
  faculty_id      String
  policy_id       String
  session_id      String
  leave_type      String
  allocated       Int      @default(0)
  used            Int      @default(0)
  pending         Int      @default(0)
  lapsed          Int      @default(0)
  carried_forward Int      @default(0)
  updatedAt       DateTime @updatedAt

  faculty Faculty         @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  policy  LeaveRulePolicy @relation(fields: [policy_id], references: [id])
  session AcademicSession @relation(fields: [session_id], references: [id])

  @@unique([faculty_id, session_id, leave_type])
  @@index([faculty_id, session_id])
}

// ─────────────────────────────────────────────────────────────
// PERMISSION GROUPS — reusable named permission bundles
// ─────────────────────────────────────────────────────────────

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String   @unique // "TT Coordinator", "Faculty Basic", "HR Manager"
  description String?
  color       String   @default("blue") // for UI badge
  permissions String[] // array of permission keys e.g. ["timetable.view","timetable.manage"]
  is_active   Boolean  @default(true)
  created_by  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments UserPermissionGroup[]
}

model UserPermissionGroup {
  id          String   @id @default(uuid())
  user_id     String
  group_id    String
  assigned_by String?
  assignedAt  DateTime @default(now())

  user  User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([user_id, group_id])
  @@index([user_id])
}

// ─────────────────────────────────────────────────────────────
// HOLIDAY MODULE
// ─────────────────────────────────────────────────────────────
model Holiday {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  name       String
  type       String   @default("GENERAL") // GENERAL | RESTRICTED | OPTIONAL | GAZETTED
  session_id String?
  dept_id    String? // null = institute-wide
  is_active  Boolean  @default(true)
  created_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session    AcademicSession? @relation(fields: [session_id], references: [id])
  department Department?      @relation(fields: [dept_id], references: [id])

  @@unique([date, dept_id])
  @@index([date])
  @@index([session_id])
}

// ─────────────────────────────────────────────────────────────
// AFFILIATED UNIVERSITY
// ─────────────────────────────────────────────────────────────
model University {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  website   String?
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliations ProgramAffiliation[]
}

model ProgramAffiliation {
  id             String    @id @default(uuid())
  university_id  String
  program_id     String?
  branch_id      String?
  affiliation_no String
  valid_from     DateTime? @db.Date
  valid_to       DateTime? @db.Date
  is_active      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  university University @relation(fields: [university_id], references: [id], onDelete: Cascade)
  program    Program?   @relation(fields: [program_id], references: [id])
  branch     Branch?    @relation(fields: [branch_id], references: [id])

  @@index([university_id])
  @@index([program_id])
  @@index([branch_id])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATION / CRON SYSTEM
// ─────────────────────────────────────────────────────────────
model NotificationConfig {
  id             String   @id @default(uuid())
  type           String   @unique // EMAIL | WHATSAPP
  is_enabled     Boolean  @default(false)
  // Email config
  smtp_host      String?
  smtp_port      Int?
  smtp_user      String?
  smtp_pass      String? // encrypted
  smtp_from      String?
  smtp_from_name String?
  // WhatsApp config (placeholder — service TBD)
  wa_api_key     String?
  wa_from        String?
  wa_provider    String? // e.g. "twilio", "wati", "360dialog"
  // Common
  updated_by     String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model NotificationTemplate {
  id            String   @id @default(uuid())
  key           String   @unique // e.g. "ATTENDANCE_REPORT", "EXAM_SCHEDULE"
  name          String
  subject       String? // email subject
  body_email    String?  @db.Text
  body_whatsapp String?  @db.Text
  variables     String[] // available variables like ["{{student_name}}", "{{date}}"]
  is_active     Boolean  @default(true)
  created_by    String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  cronSchedules CronSchedule[]
}

model CronSchedule {
  id           String    @id @default(uuid())
  name         String
  key          String    @unique // e.g. "DAILY_ATTENDANCE_REPORT"
  cron_expr    String // e.g. "0 8 * * *" = daily 8am
  template_key String?
  channel      String    @default("EMAIL") // EMAIL | WHATSAPP | BOTH
  recipients   String[] // email addresses OR phone numbers
  is_active    Boolean   @default(true)
  last_run     DateTime?
  last_status  String? // SUCCESS | FAILED
  last_error   String?
  created_by   String?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  template NotificationTemplate? @relation(fields: [template_key], references: [key])
}

// ─────────────────────────────────────────────────────────────
// FACULTY QUALIFICATION (separate table)
// Teaching faculty: 10th & 12th mandatory, higher optional
// Non-teaching: no qualification needed
// ─────────────────────────────────────────────────────────────
model FacultyQualification {
  id               String   @id @default(uuid())
  faculty_id       String
  level            String // TENTH | TWELFTH | DIPLOMA | BACHELOR | MASTER | PHD | OTHER
  board_university String?
  institution      String?
  subject_stream   String?
  percentage       Float?
  grade            String?
  year_of_passing  Int?
  certificate_url  String?
  is_verified      Boolean  @default(false)
  verified_by      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  faculty Faculty @relation(fields: [faculty_id], references: [id], onDelete: Cascade)

  @@index([faculty_id])
  @@index([level])
}
