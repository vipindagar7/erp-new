// ═══════════════════════════════════════════════════════════════
// V3 — ROOMS, TIMETABLE, WORKLOAD
// ═══════════════════════════════════════════════════════════════

enum RoomType {
  CLASSROOM
  LAB
  SEMINAR_HALL
  AUDITORIUM
  TRAINING_ROOM
  CONFERENCE_ROOM
  LIBRARY
  OTHER
}

enum PeriodType {
  LECTURE
  LAB
  LUNCH
  BREAK
  ASSEMBLY
  OTHER
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  LOCKED
  ARCHIVED
}

enum EntryType {
  LECTURE
  LAB
  TUTORIAL
  FREE
  LUNCH
  BREAK
}

enum SubstStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// ─── Room / Lab Master ────────────────────────────────────────
model Room {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  type             RoomType          @default(CLASSROOM)
  capacity         Int               @default(60)
  floor            String?
  block            String?
  description      String?
  is_active        Boolean           @default(true)
  dept_id          String?
  department       Department?       @relation(fields: [dept_id], references: [id])
  subjects         RoomSubject[]
  staff            RoomStaff[]
  timetableEntries TimetableEntry[]
  workloads        FacultyWorkload[]
  examRooms        ExamRoom[]
  deleted_at       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model RoomSubject {
  id         String  @id @default(uuid())
  room_id    String
  subject_id String
  room       Room    @relation(fields: [room_id], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([room_id, subject_id])
}

model RoomStaff {
  id        String   @id @default(uuid())
  room_id   String
  user_id   String
  role      String   @default("LAB_STAFF")
  room      Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  facultyId String?

  @@unique([room_id, user_id])
}

// ─── Period Config ────────────────────────────────────────────
model PeriodConfig {
  id         String           @id @default(uuid())
  session_id String
  name       String
  type       PeriodType       @default(LECTURE)
  start_time String
  end_time   String
  order      Int              @default(0)
  days       String[]
  is_active  Boolean          @default(true)
  session    AcademicSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  entries    TimetableEntry[]
  createdAt  DateTime         @default(now())

  @@unique([session_id, order])
}

// ─── Timetable ────────────────────────────────────────────────
model Timetable {
  id           String              @id @default(uuid())
  session_id   String
  section_id   String              @unique
  dept_id      String?
  status       TimetableStatus     @default(DRAFT)
  locked       Boolean             @default(false)
  locked_by    String?
  locked_at    DateTime?
  generated_at DateTime?
  session      AcademicSession     @relation(fields: [session_id], references: [id])
  section      Section             @relation(fields: [section_id], references: [id])
  department   Department?         @relation(fields: [dept_id], references: [id])
  entries      TimetableEntry[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  entryLogs    TimetableEntryLog[]
  snapshots    TimetableSnapshot[]
}

model TimetableEntry {
  id                  String         @id @default(uuid())
  timetable_id        String
  period_config_id    String
  day                 String
  subject_id          String?
  faculty_id          String?
  room_id             String?
  entry_type          EntryType      @default(LECTURE)
  notes               String?
  is_combined         Boolean        @default(false)
  combined_section_id String?
  combined_label      String? // custom label for combined slot
  span_periods        Int            @default(1) // 1=normal, 2=double period
  timetable           Timetable      @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  period_config       PeriodConfig   @relation(fields: [period_config_id], references: [id])
  subject             Subject?       @relation(fields: [subject_id], references: [id])
  faculty             Faculty?       @relation(fields: [faculty_id], references: [id])
  room                Room?          @relation(fields: [room_id], references: [id])
  substitutions       Substitution[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([timetable_id, day, period_config_id])
}

// ─── Substitution ─────────────────────────────────────────────
model Substitution {
  id                    String         @id @default(uuid())
  entry_id              String
  date                  DateTime
  original_faculty_id   String
  substitute_faculty_id String
  status                SubstStatus    @default(PENDING)
  reason                String?
  leave_id              String?
  requested_at          DateTime       @default(now())
  responded_at          DateTime?
  response_note         String?
  entry                 TimetableEntry @relation(fields: [entry_id], references: [id])
  original_faculty      Faculty        @relation("OriginalFaculty", fields: [original_faculty_id], references: [id])
  substitute            Faculty        @relation("SubstituteFaculty", fields: [substitute_faculty_id], references: [id])
  createdAt             DateTime       @default(now())
}

// ─── Faculty Workload ─────────────────────────────────────────
model FacultyWorkload {
  id                String          @id @default(uuid())
  session_id        String
  faculty_id        String
  subject_id        String
  section_id        String
  weekly_hours      Int             @default(4)
  preferred_days    String[]
  preferred_periods Int[]
  room_id           String?
  entry_type        EntryType       @default(LECTURE)
  session           AcademicSession @relation(fields: [session_id], references: [id])
  faculty           Faculty         @relation(fields: [faculty_id], references: [id])
  subject           Subject         @relation(fields: [subject_id], references: [id])
  section           Section         @relation(fields: [section_id], references: [id])
  room              Room?           @relation(fields: [room_id], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([session_id, faculty_id, subject_id, section_id])
}

// ═══════════════════════════════════════════════════════════════
// V3 — LEAVE & ATTENDANCE
// ═══════════════════════════════════════════════════════════════

// ─── Leave Types (created by HR) ─────────────────────────────
model LeaveType {
  id                String             @id @default(uuid())
  code              String             @unique // CL, EL, ML, PL
  name              String // Casual Leave
  applicable_to     String[]           @default([]) // ["TEACHING","NON_TEACHING","ALL"]
  max_days_per_year Int                @default(0)
  carry_forward     Boolean            @default(false)
  carry_forward_max Int? // max days to carry
  is_paid           Boolean            @default(true)
  requires_document Boolean            @default(false)
  min_days          Float              @default(0.5)
  max_consecutive   Int?
  notice_days       Int                @default(0) // advance notice required
  is_active         Boolean            @default(true)
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  policyRules       LeavePolicyRule[]
  balances          LeaveBalance[]
  applications      LeaveApplication[]
}

// ─── Leave Policy (contract type → leave entitlements) ───────
model LeavePolicy {
  id              String               @id @default(uuid())
  name            String               @unique // "Permanent Teaching Staff Policy"
  contract_types  String[] // ["PERMANENT","CONTRACT"]
  employee_types  String[] // ["TEACHING","NON_TEACHING"]
  sat_off_rule    String               @default("NONE") // ALL / FIRST_THIRD / SECOND_FOURTH / NONE
  is_active       Boolean              @default(true)
  accepted_by     String[]             @default([]) // user_ids who accepted T&C
  terms_text      String? // T&C content
  version         Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rules           LeavePolicyRule[]
  facultyPolicies FacultyLeavePolicy[]
}

model LeavePolicyRule {
  id                String      @id @default(uuid())
  policy_id         String
  leave_type_id     String
  days_per_year     Int
  carry_forward     Boolean     @default(false)
  carry_forward_max Int?
  policy            LeavePolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  leave_type        LeaveType   @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([policy_id, leave_type_id])
}

// Faculty → Policy assignment
model FacultyLeavePolicy {
  id          String      @id @default(uuid())
  faculty_id  String      @unique
  policy_id   String
  accepted    Boolean     @default(false)
  accepted_at DateTime?
  assigned_by String?
  createdAt   DateTime    @default(now())
  faculty     Faculty     @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  policy      LeavePolicy @relation(fields: [policy_id], references: [id])
}

// ─── Leave Balance ────────────────────────────────────────────
model LeaveBalance {
  id              String    @id @default(uuid())
  faculty_id      String
  leave_type_id   String
  academic_year   String // "2024-25"
  total_days      Float     @default(0)
  used_days       Float     @default(0)
  pending_days    Float     @default(0) // in pending applications
  carried_forward Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  faculty         Faculty   @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  leave_type      LeaveType @relation(fields: [leave_type_id], references: [id])

  @@unique([faculty_id, leave_type_id, academic_year])
}

// ─── Leave Approval Workflow ──────────────────────────────────
model LeaveApprovalWorkflow {
  id         String   @id @default(uuid())
  faculty_id String   @unique
  steps      Json     @default("[]") // [{level:1, approver_id:"...", role:"HOD"}]
  created_by String?
  updatedAt  DateTime @updatedAt
  faculty    Faculty  @relation("FacultyApprovalWorkflow", fields: [faculty_id], references: [id], onDelete: Cascade)
}

// ─── Leave Application ────────────────────────────────────────
model LeaveApplication {
  id               String              @id @default(uuid())
  faculty_id       String
  leave_type_id    String
  from_date        DateTime
  to_date          DateTime
  total_days       Float
  half_day         Boolean             @default(false)
  half_day_period  String? // MORNING / AFTERNOON
  reason           String
  documents        String[]            @default([])
  status           String              @default("PENDING") // PENDING/APPROVED/REJECTED/CANCELLED/WITHDRAWN
  current_level    Int                 @default(1)
  policy_accepted  Boolean             @default(false)
  policy_version   Int?
  remarks          String?
  rejection_reason String?
  cancelled_by     String?
  cancelled_at     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  faculty          Faculty             @relation("FacultyLeaveApps", fields: [faculty_id], references: [id], onDelete: Cascade)
  leave_type       LeaveType           @relation(fields: [leave_type_id], references: [id])
  approvalSteps    LeaveApprovalStep[]
  substitutions    LeaveSubstitution[]

  @@index([faculty_id, status])
  @@index([from_date, to_date])
}

model LeaveApprovalStep {
  id             String           @id @default(uuid())
  application_id String
  approver_id    String
  approver_role  String?
  level          Int
  status         String           @default("PENDING")
  remarks        String?
  actioned_at    DateTime?
  notified_at    DateTime?
  createdAt      DateTime         @default(now())
  application    LeaveApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  approver       Faculty          @relation("LeaveStepApprover", fields: [approver_id], references: [id])
  leaveRequest   LeaveRequest?    @relation(fields: [leaveRequestId], references: [id])
  leaveRequestId String?

  @@index([application_id])
  @@index([approver_id, status])
}

// Substitute assignment per lecture during leave
model LeaveSubstitution {
  id             String           @id @default(uuid())
  application_id String
  entry_id       String? // TimetableEntry id
  date           DateTime
  period_name    String
  subject_name   String?
  original_id    String
  substitute_id  String
  status         String           @default("PENDING") // PENDING/ACCEPTED/REJECTED
  responded_at   DateTime?
  response_note  String?
  createdAt      DateTime         @default(now())
  application    LeaveApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  original       Faculty          @relation("SubstOriginal", fields: [original_id], references: [id])
  substitute     Faculty          @relation("SubstFaculty", fields: [substitute_id], references: [id])

  @@index([application_id])
  @@index([substitute_id, status])
}

// Student leave
model StudentLeave {
  id          String    @id @default(uuid())
  student_id  String
  from_date   DateTime
  to_date     DateTime
  total_days  Int
  reason      String
  documents   String[]  @default([])
  status      String    @default("PENDING")
  approved_by String?
  approved_at DateTime?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  student     Student   @relation("StudentLeaves", fields: [student_id], references: [id], onDelete: Cascade)

  approvals StudentLeaveApproval[]

  @@index([student_id, status])
}

// ─── Attendance ───────────────────────────────────────────────
// Session-level freeze control
model AttendanceFreezeRule {
  id            String          @id @default(uuid())
  session_id    String
  scope         String          @default("INSTITUTE") // INSTITUTE/DEPT/SECTION
  scope_id      String? // dept_id or section_id
  is_frozen     Boolean         @default(false)
  frozen_by     String?
  frozen_at     DateTime?
  freeze_reason String?
  unfrozen_by   String?
  unfrozen_at   DateTime?
  createdAt     DateTime        @default(now())
  session       AcademicSession @relation(fields: [session_id], references: [id])

  @@unique([session_id, scope, scope_id])
}

// Student attendance per lecture
model StudentAttendance {
  id                String          @id @default(uuid())
  session_id        String
  section_id        String
  subject_id        String
  student_id        String
  faculty_id        String?
  date              DateTime        @db.Date
  period_name       String // P1, P2, Lab1...
  period_config_id  String?
  status            String          @default("PRESENT") // PRESENT/ABSENT/LATE/EXCUSED/ON_LEAVE
  is_late           Boolean         @default(false)
  late_reason       String?
  late_approved_by  String?
  late_approved_at  DateTime?
  marked_by         String?
  marked_at         DateTime        @default(now())
  is_frozen         Boolean         @default(false)
  back_entry        Boolean         @default(false)
  back_entry_reason String?
  back_entry_by     String?
  updatedAt         DateTime        @updatedAt
  session           AcademicSession @relation(fields: [session_id], references: [id])
  section           Section         @relation(fields: [section_id], references: [id])
  subject           Subject         @relation(fields: [subject_id], references: [id])
  student           Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  faculty           Faculty?        @relation(fields: [facultyId], references: [id])
  facultyId         String?

  @@unique([session_id, section_id, subject_id, student_id, date, period_name])
  @@index([student_id, session_id])
  @@index([section_id, date])
  @@index([subject_id, session_id])
  @@index([date])
}

// Faculty biometric attendance
model FacultyAttendance {
  id         String    @id @default(uuid())
  faculty_id String
  date       DateTime  @db.Date
  in_time    DateTime?
  out_time   DateTime?
  status     String    @default("PRESENT") // PRESENT/ABSENT/HALF_DAY/ON_LEAVE/HOLIDAY
  source     String    @default("BIOMETRIC") // BIOMETRIC/MANUAL
  device_id  String?
  raw_logs   Json? // store all punch events
  remarks    String?
  marked_by  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  faculty    Faculty   @relation(fields: [faculty_id], references: [id], onDelete: Cascade)

  @@unique([faculty_id, date])
  @@index([faculty_id, date])
  @@index([date])
}

// ═══════════════════════════════════════════════════════════════
// V3 — TIMETABLE EXTENSIONS
// ═══════════════════════════════════════════════════════════════

// ─── Timetable Generation Config (admin sets before generate) ─
model TimetableGenConfig {
  id                      String    @id @default(uuid())
  session_id              String
  dept_id                 String?
  theory_periods_per_week Int       @default(1) // per subject per week
  lab_periods_per_week    Int       @default(2) // labs run 2 consecutive slots
  lab_consecutive         Boolean   @default(true)
  allow_combined_sections Boolean   @default(false)
  combined_rules          Json? // [{subject_id, section_ids, max_students}]
  working_days            String[]  @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  max_periods_per_day     Int       @default(8)
  generated_at            DateTime?
  generated_by            String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// ─── Course Structure (faculty uploads syllabus/topic list) ───
model CourseStructure {
  id            String          @id @default(uuid())
  faculty_id    String
  subject_id    String
  section_id    String
  session_id    String
  unit_no       Int
  unit_title    String
  topic         String
  sub_topic     String?
  planned_hours Float           @default(1)
  order         Int             @default(0)
  is_covered    Boolean         @default(false)
  covered_on    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  faculty       Faculty         @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  subject       Subject         @relation(fields: [subject_id], references: [id])
  section       Section         @relation(fields: [section_id], references: [id])
  session       AcademicSession @relation(fields: [session_id], references: [id])

  @@index([faculty_id, subject_id, section_id])
}

// ─── Topic Taught (faculty marks per lecture) ─────────────────
model TopicTaught {
  id              String          @id @default(uuid())
  attendance_date DateTime        @db.Date
  period_name     String
  faculty_id      String
  subject_id      String
  section_id      String
  session_id      String
  course_topic_id String? // FK to CourseStructure (optional)
  topic_text      String // free text — faculty types or selects
  sub_topic       String?
  teaching_method String? // LECTURE | DEMO | PRACTICAL | DISCUSSION | SEMINAR
  remarks         String?
  createdAt       DateTime        @default(now())
  faculty         Faculty         @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subject_id], references: [id])
  section         Section         @relation(fields: [section_id], references: [id])
  session         AcademicSession @relation(fields: [session_id], references: [id])

  @@unique([attendance_date, period_name, faculty_id, subject_id, section_id])
  @@index([faculty_id, attendance_date])
  @@index([section_id, attendance_date])
}

// ─── Seminar / Workshop / Training Session ────────────────────
model SpecialSession {
  id                   String                     @id @default(uuid())
  session_id           String
  title                String
  type                 String                     @default("SEMINAR") // SEMINAR | WORKSHOP | TRAINING | GUEST_LECTURE
  organizer            String?
  venue                String?
  from_date            DateTime
  to_date              DateTime
  from_time            String?
  to_time              String?
  attendance_counts_as String                     @default("PRESENT") // PRESENT | EXCUSED | SPECIAL
  section_ids          String[] // which sections attend
  faculty_ids          String[] // which faculty attend
  created_by           String?
  description          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  session              AcademicSession            @relation(fields: [session_id], references: [id])
  attendances          SpecialSessionAttendance[]
}

model SpecialSessionAttendance {
  id                 String         @id @default(uuid())
  special_session_id String
  student_id         String?
  faculty_id         String?
  status             String         @default("PRESENT")
  marked_by          String?
  createdAt          DateTime       @default(now())
  special_session    SpecialSession @relation(fields: [special_session_id], references: [id], onDelete: Cascade)

  @@unique([special_session_id, student_id])
  @@unique([special_session_id, faculty_id])
}

// ─── Daily Reports ────────────────────────────────────────────
model DailyReport {
  id           String   @id @default(uuid())
  report_date  DateTime @db.Date
  report_type  String // FACULTY | STUDENT | SECTION | DEPT | BRANCH | PROGRAM | SESSION
  // Scope fields — one will be set depending on type
  faculty_id   String?
  student_id   String?
  section_id   String?
  dept_id      String?
  branch_id    String?
  program_id   String?
  session_id   String?
  // Report data (snapshot)
  data         Json
  generated_at DateTime @default(now())
  generated_by String? // "CRON" | user_id

  @@unique([report_date, report_type, faculty_id])
  @@unique([report_date, report_type, student_id])
  @@unique([report_date, report_type, section_id])
  @@unique([report_date, report_type, dept_id])
  @@index([report_date])
  @@index([report_type, report_date])
}

// ═══════════════════════════════════════════════════════════════
// V3 — TIMETABLE HISTORY
// ═══════════════════════════════════════════════════════════════

// Per-entry change log (every slot change)
model TimetableEntryLog {
  id                 String          @id @default(uuid())
  timetable_id       String
  section_id         String
  session_id         String
  day                String
  period_config_id   String
  action             String // ASSIGN | CLEAR | SWAP | DRAG | PUBLISH | AUTO_GENERATE
  prev_subject_id    String?
  prev_faculty_id    String?
  prev_room_id       String?
  prev_entry_type    String?
  new_subject_id     String?
  new_faculty_id     String?
  new_room_id        String?
  new_entry_type     String?
  // For swap/drag across sections
  swap_with_entry_id String?
  swap_section_id    String?
  changed_by         String? // user_id
  changed_by_name    String?
  changed_by_role    String?
  notes              String?
  createdAt          DateTime        @default(now())
  // Relations for display
  timetable          Timetable       @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  section            Section         @relation("EntryLogSection", fields: [section_id], references: [id])
  session            AcademicSession @relation(fields: [session_id], references: [id])

  @@index([timetable_id])
  @@index([section_id])
  @@index([changed_by])
  @@index([createdAt])
}

// Full timetable snapshot (created on publish/lock or manual save)
model TimetableSnapshot {
  id                String          @id @default(uuid())
  timetable_id      String
  section_id        String
  session_id        String
  version           Int             @default(1)
  label             String? // "Week 1 Final", "After Mid-sem", etc.
  is_active         Boolean         @default(false) // only one ACTIVE per timetable
  snapshot_data     Json // full entries array — hardcoded, never deleted
  published_by      String?
  published_by_name String?
  reason            String?
  createdAt         DateTime        @default(now())
  // NO updatedAt — snapshots are immutable
  timetable         Timetable       @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  section           Section         @relation("SnapshotSection", fields: [section_id], references: [id])
  session           AcademicSession @relation(fields: [session_id], references: [id])

  @@index([timetable_id, is_active])
  @@index([section_id])
}

// ─── Faculty Subject Preference Requests ─────────────────────
model FacultySubjectRequest {
  id           String          @id @default(uuid())
  faculty_id   String
  subject_id   String
  session_id   String
  preference   Int             @default(1) // 1 or 2
  status       String          @default("PENDING") // PENDING|APPROVED|REJECTED
  requested_at DateTime        @default(now())
  reviewed_by  String?
  reviewed_at  DateTime?
  review_note  String?
  faculty      Faculty         @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  subject      Subject         @relation(fields: [subject_id], references: [id])
  session      AcademicSession @relation(fields: [session_id], references: [id])

  @@unique([faculty_id, subject_id, session_id])
  @@index([faculty_id, status])
  @@index([session_id, status])
}

