  changed_fields  String[] @default([])
  prev_data       Json?
  new_data        Json?
  reason          String?
  changed_by      String?
  changed_by_name String?
  changed_by_role String?
  is_rollback     Boolean  @default(false)
  rolled_back_to  String?
  createdAt       DateTime @default(now())

  @@index([program_id])
  @@index([action])
  @@index([createdAt])
}

model BranchHistory {
  id              String   @id @default(uuid())
  branch_id       String
  action          String
  changed_fields  String[] @default([])
  prev_data       Json?
  new_data        Json?
  reason          String?
  changed_by      String?
  changed_by_name String?
  changed_by_role String?
  is_rollback     Boolean  @default(false)
  rolled_back_to  String?
  createdAt       DateTime @default(now())

  @@index([branch_id])
  @@index([action])
  @@index([createdAt])
}

model SectionSnapshot {
  id                String    @id @default(uuid())
  section_id        String
  section_code      String
  trigger           String
  triggered_by      String?
  triggered_by_name String?
  section_data      Json
  students_data     Json
  enrollments_data  Json
  subjects_data     Json
  from_semester     Int?
  to_semester       Int?
  from_session      String?
  to_session        String?
  reason            String?
