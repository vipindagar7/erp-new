// ═══════════════════════════════════════════════════════════════
// EIT ERP Schema v3.0
// Hierarchy: Department → Program → Branch → Section
// V3 additions: Room/Lab master, Timetable, PeriodConfig,
//               Substitution, FacultyWorkload
// ═══════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── RBAC ─────────────────────────────────────────────────────
model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  label           String
  description     String?
  is_system       Boolean          @default(false)
  is_active       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  activeUsers     User[]           @relation("ActiveRole")
  facultyPrimary   Faculty[] @relation("FacultyPrimaryRole")
  facultySecondary Faculty[] @relation("FacultySecondaryRole")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  module          String
  action          String
  label           String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model RolePermission {
  id            String     @id @default(uuid())
  role_id       String
  permission_id String
  createdAt     DateTime   @default(now())
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
}

model UserRole {
  id         String    @id @default(uuid())
  user_id    String
  role_id    String
  dept_id    String?
  section_id String?
  granted_by String?
  granted_at DateTime  @default(now())
  expires_at DateTime?
  is_active  Boolean   @default(true)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, dept_id, section_id])
  @@index([user_id])
  @@index([role_id])
  @@index([dept_id])
}

model UserPermission {
  id            String     @id @default(uuid())
  user_id       String
  permission_id String
  type          String     @default("GRANT")
  granted_by    String?
  createdAt     DateTime   @default(now())
  expires_at    DateTime?
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_id])
  @@index([user_id])
}

// ─── User ─────────────────────────────────────────────────────
model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  passwordHash          String
  isBlocked             Boolean              @default(false)
  active_role_id        String?
  is_root               Boolean              @default(false)
  must_change_password  Boolean              @default(false)
  pin_hash              String?
  pin_set_at            DateTime?
  requires_2fa          Boolean              @default(false)
  first_login_completed Boolean              @default(false)
  role                  String               @default("STUDENT")
  permissions           String[]             @default([])
  extra_roles           String[]             @default([])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userRoles             UserRole[]
  userPermissions       UserPermission[]
  userSessions          UserSession[]
  loginHistory          LoginHistory[]
  activeRole            Role?                @relation("ActiveRole", fields: [active_role_id], references: [id])
  admin                 Admin?
  auditLogs             AuditLog[]
  faculty               Faculty?
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  student               Student?
  otpTokens             OtpToken[]
  userTotp              UserTotp?
  roomStaff             RoomStaff[] // V3
  permissionGroups      UserPermissionGroup[]

  @@index([is_root])
}

model UserSession {
  id                 String    @id @default(uuid())
  user_id            String
  jti                String    @unique
  refresh_token_hash String    @unique
  active_role_id     String?
  ip_address         String?
  user_agent         String?
  device_type        String?
  browser            String?
  os                 String?
  location           String?
  is_active          Boolean   @default(true)
  is_locked          Boolean   @default(false)
  locked_at          DateTime?
  last_active_at     DateTime  @default(now())
  expires_at         DateTime
  refresh_expires_at DateTime
  revoked_at         DateTime?
  revoked_reason     String?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([jti])
  @@index([is_active])
  @@index([expires_at])
}

model LoginHistory {
  id          String   @id @default(uuid())
  user_id     String?
  email       String
  status      String
  fail_reason String?
  ip_address  String?
  user_agent  String?
  device_type String?
  browser     String?
  os          String?
  location    String?
  session_id  String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([ip_address])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user_id   String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(uuid())
  user_id   String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ─── Academic Session ─────────────────────────────────────────
model AcademicSession {
  id                     String                  @id @default(uuid())
  code                   String                  @unique
  name                   String                  @unique
  label                  String?
  start_date             DateTime
  end_date               DateTime
  is_current             Boolean                 @default(false)
  is_locked              Boolean                 @default(false)
  created_by             String?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  enrollments            StudentEnrollment[]
  sectionSubjects        SectionSubject[]
  sectionHistories       SectionHistory[]
  sectionSubjectHistory  SectionSubjectHistory[]
  curriculumSubjects     CurriculumSubject[]
  academicPeriods        AcademicPeriod[]
  periodConfigs          PeriodConfig[] // V3
  timetables             Timetable[] // V3
  workloads              FacultyWorkload[] // V3
  attendanceFreezeRules  AttendanceFreezeRule[]
  studentAttendance      StudentAttendance[]
  timetableEntryLogs     TimetableEntryLog[]
  timetableSnapshots     TimetableSnapshot[]
  facultySubjectRequests FacultySubjectRequest[]
  courseStructures       CourseStructure[]
  topicTaughts           TopicTaught[]
  specialSessions        SpecialSession[]
  calendarEvents         AcademicCalendarEvent[]
  extraAttendance        ExtraAttendance[]
  assignments            Assignment[]
  exams                  Exam[]
  feeStructures          FeeStructure[]
  feePayments            FeePayment[]
  leavePolicies          LeaveRulePolicy[]
  leaveSlots             LeaveSlot[]
  salaryCycles           SalaryCycle[]
  facultyLeaveQuotas     FacultyLeaveQuota[]
  holidays               Holiday[]

  @@index([is_current])
  @@index([code])
}

// ─── Department ───────────────────────────────────────────────
model Department {
  id               String              @id @default(uuid())
  code             String              @unique
  name             String              @unique
  hod_id           String?
  description      String?
  website          String?
  phone            String?
  established_year Int?
  deleted_at       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  hod              Faculty?            @relation("DepartmentHOD", fields: [hod_id], references: [id])
  faculties        Faculty[]
  programs         Program[]
  students         Student[]
  enrollments      StudentEnrollment[]
  feedbackForms    FeedbackForm[]
  roomsLabs        Room[]
  adminScopes      AdminDeptScope[] // V3 (renamed from rooms to avoid conflict with old String[] field)
  timetables       Timetable[] // V3
  holidays         Holiday[]

  @@index([code])
}

// ─── Program ──────────────────────────────────────────────────
model Program {
  id                 String               @id @default(uuid())
  code               String               @unique
  name               String
  dept_id            String
  max_semesters      Int?
  duration_years     Int?
  degree_type        String?
  accreditation      String?
  intake_capacity    Int?
  description        String?
  deleted_at         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  department         Department           @relation(fields: [dept_id], references: [id], onDelete: Cascade)
  branches           Branch[]
  students           Student[]
  enrollments        StudentEnrollment[]
  curriculumSubjects CurriculumSubject[]
  feedbackForms      FeedbackForm[]
  affiliations       ProgramAffiliation[]

  @@index([dept_id])
  @@index([code])
}

// ─── Branch ───────────────────────────────────────────────────
model Branch {
  id                       String               @id @default(uuid())
  code                     String               @unique
  name                     String
  program_id               String
  description              String?
  intake_capacity          Int?
  total_semesters_override Int?
  has_combined_first_year  Boolean              @default(false)
  start_session            String?
  end_session              String?
  discontinued_at          DateTime?
  discontinued_reason      String?
  discontinued_by          String?
  deleted_at               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  program                  Program              @relation(fields: [program_id], references: [id], onDelete: Cascade)
  sections                 Section[]
  students                 Student[]
  enrollments              StudentEnrollment[]
  affiliations             ProgramAffiliation[]

  @@index([program_id])
  @@index([code])
  @@index([discontinued_at])
}

// ─── Subject ──────────────────────────────────────────────────
model Subject {
  id                    String                  @id @default(uuid())
  name                  String
  code                  String                  @unique
  nickname              String?
  category              String                  @default("THEORY")
  credits               Int                     @default(4)
  deleted_at            DateTime?
  createdAt             DateTime                @default(now())
  curriculumSubjects    CurriculumSubject[]
  facultySubjects       FacultySubject[]
  feedbackForms         FeedbackForm[]
  sectionSubjects       SectionSubject[]        @relation("SectionSubjectSubject")
  sectionSubjectHistory SectionSubjectHistory[] @relation("SubjectSubjectHistory")
  students              StudentSubject[]
  roomSubjects          RoomSubject[] // V3
  timetableEntries      TimetableEntry[] // V3
  workloads             FacultyWorkload[] // V3
  studentAttendance     StudentAttendance[]
  courseStructures      CourseStructure[]
  topicsTaught          TopicTaught[]
  subjectRequests       FacultySubjectRequest[]
  assignments           Assignment[]
  examSchedules         ExamSchedule[]
  examMarks             ExamMark[]
  questionPapers        QuestionPaper[]

  @@index([code])
}

// ─── Section ──────────────────────────────────────────────────
model Section {
  id                    String                  @id @default(uuid())
  code                  String                  @unique
  name                  String
  branch_id             String
  semester              Int
  batch                 String
  batch_year            Int?
  academic_year         String?
  is_combined           Boolean                 @default(false)
  class_coordinator_id  String?
  status                String                  @default("ACTIVE")
  capacity              Int?
  description           String?
  room_no               String?
  deleted_at            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  branch                Branch                  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  class_coordinator     Faculty?                @relation("SectionCoordinator", fields: [class_coordinator_id], references: [id])
  students              Student[]
  enrollments           StudentEnrollment[]
  sectionSubjects       SectionSubject[]        @relation("SectionSubjectSection")
  sectionSubjectHistory SectionSubjectHistory[] @relation("SectionSubjectHistory")
  sectionHistory        SectionHistory[]        @relation("SectionHistory")
  studentSectionHistory StudentSectionHistory[]
  feedbackForms         FeedbackForm[]
  timetable             Timetable? // V3
  workloads             FacultyWorkload[] // V3
  studentAttendance     StudentAttendance[]
  timetableEntryLogs    TimetableEntryLog[]     @relation("EntryLogSection")
  timetableSnapshots    TimetableSnapshot[]     @relation("SnapshotSection")
  courseStructures      CourseStructure[]
  topicTaughts          TopicTaught[]

  @@index([branch_id])
  @@index([code])
  @@index([semester])
  @@index([status])
}

model StudentSectionHistory {
  id                String   @id @default(uuid())
  student_id        String
  from_section_id   String?
  to_section_id     String
  from_section_code String?
  to_section_code   String?
  reason            String?
  changed_by        String?
  changed_by_name   String?
  createdAt         DateTime @default(now())
  student           Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  to_section        Section  @relation(fields: [to_section_id], references: [id])

  @@index([student_id])
  @@index([createdAt])
}

model SectionSubject {
  id         String          @id @default(uuid())
  session_id String
  section_id String
  subject_id String
  faculty_id String?
  type       String          @default("REGULAR")
  status     String          @default("ACTIVE")
  session    AcademicSession @relation(fields: [session_id], references: [id])
  faculty    Faculty?        @relation("SectionSubjectFaculty", fields: [faculty_id], references: [id])
  section    Section         @relation("SectionSubjectSection", fields: [section_id], references: [id], onDelete: Cascade)
  subject    Subject         @relation("SectionSubjectSubject", fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([session_id, section_id, subject_id])
  @@index([session_id])
  @@index([section_id])
}

model SectionSubjectHistory {
  id         String          @id @default(uuid())
  session_id String
  section_id String
  subject_id String
  faculty_id String?
  facultyId  String?
  action     String
  reason     String?
  prev_data  Json?
  new_data   Json?
  changed_by String?
  createdAt  DateTime        @default(now())
  session    AcademicSession @relation(fields: [session_id], references: [id])
  section    Section         @relation("SectionSubjectHistory", fields: [section_id], references: [id], onDelete: Cascade)
  subject    Subject         @relation("SubjectSubjectHistory", fields: [subject_id], references: [id], onDelete: Cascade)
  faculty    Faculty?        @relation(fields: [facultyId], references: [id])

  @@index([session_id])
  @@index([section_id])
  @@index([action])
  @@index([createdAt])
  @@index([subject_id])
}

model SectionHistory {
  id                        String          @id @default(uuid())
  session_id                String
  section_id                String
  action                    String
  semester                  Int
  status                    String
  batch                     String
  academic_year             String?
  class_coordinator_id      String?
  coordinator_name          String?
  prev_semester             Int?
  prev_status               String?
  prev_batch                String?
  prev_class_coordinator_id String?
  prev_coordinator_name     String?
  prev_subjects             Json?
  new_subjects              Json?
  changed_by                String?
  changed_by_name           String?
  changed_by_role           String?
  reason                    String?
  createdAt                 DateTime        @default(now())
  session                   AcademicSession @relation(fields: [session_id], references: [id])
  section                   Section         @relation("SectionHistory", fields: [section_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([section_id])
  @@index([action])
  @@index([createdAt])
}

// ─── Student ──────────────────────────────────────────────────
model Student {
  id                 String    @id @default(uuid())
  code               String?   @unique
  user_id            String    @unique
  name               String
  first_name         String
  last_name          String?
  roll_no            String?   @unique
  university_roll_no String?   @unique
  enrollment_no      String?   @unique
  dob                DateTime?
  gender             String?
  phone              String?
  father_name        String?
  mother_name        String?
  father_phone       String?
  mother_phone       String?
  admission_year     Int?
  batch_year         Int?
  session            String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  dept_id            String?
  program_id         String?
  branch_id          String?
  section_id         String?
  status             String    @default("ACTIVE")
  aadhar_no          String?
  category           String?
  group              String?
  mode_of_admission  String?
  pan_no             String?
  personal_email     String?
  religion           String?
  group_no           String?
  deleted_at         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  blood_group        String?
  photo_url          String?
  emergency_contact  String?
  emergency_phone    String?
  emergency_relation String?
  father_aadhar      String?
  mother_aadhar      String?
  father_occupation  String?
  mother_occupation  String?
  tenth_percentage   Float?
  twelfth_percentage Float?
  lateral_entry      Boolean   @default(false)
  is_alumni          Boolean   @default(false)
  is_hosteller       Boolean   @default(false)
  is_using_transport Boolean   @default(false)
  alt_contact_number String?
  biometric_id       String?   @unique
  nick_name          String?
  admission_date     String?

  department            Department?              @relation(fields: [dept_id], references: [id])
  program               Program?                 @relation(fields: [program_id], references: [id])
  branch                Branch?                 @relation(fields: [branch_id], references: [id])
  section               Section?                @relation(fields: [section_id], references: [id])
  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollments           StudentEnrollment[]
  subjects              StudentSubject[]
  sectionHistory        StudentSectionHistory[]
  studentHistories      StudentHistory[]
  feedbackForms         FeedbackFormStudent[]
  feedbackResponses     FeedbackResponse[]
  specialGroupMembers   SpecialGroupMember[]
  // Leave
  studentLeaves         StudentLeave[]          @relation("StudentLeaves")
  // Attendance
  attendance            StudentAttendance[]
  extraAttendance       ExtraAttendance[]
  // Assignment
  assignmentSubmissions AssignmentSubmission[]
  assignmentGrades      AssignmentGrade[]
  // Exam
  examSeatings          ExamSeating[]
  hallTickets           HallTicket[]
  examMarks             ExamMark[]
  // Fee
  feePayments           FeePayment[]
  // Skill Card
  skillCard             StudentSkillCard?
  skillCardEntries      SkillCardEntry[]

  @@index([dept_id])
  @@index([program_id])
  @@index([branch_id])
  @@index([section_id])
  @@index([code])
  @@index([status])
}

model StudentHistory {
  id              String   @id @default(uuid())
  student_id      String
  changed_by      String?
  changed_by_name String?
  action          String
  changed_fields  String[] @default([])
  prev_data       Json?
  new_data        Json?
  createdAt       DateTime @default(now())
  student         Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([createdAt])
}

model StudentSubject {
  id         String  @id @default(uuid())
  student_id String
  subject_id String
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([student_id, subject_id])
}

// ─── Student Enrollment ───────────────────────────────────────
model StudentEnrollment {
  id                       String          @id @default(uuid())
  session_id               String
  student_id               String
  section_id               String
  academic_year            String
  semester                 Int
  batch_year               Int             @default(0)
  dept_id                  String
  program_id               String
  branch_id                String?
  status                   String          @default("ACTIVE")
  is_current               Boolean         @default(true)
  enrolled_at              DateTime        @default(now())
  completed_at             DateTime?
  remarks                  String?
  promoted_from_section_id String?
  promoted_to_section_id   String?
  promoted_by              String?
  promoted_at              DateTime?
  demotion_reason          String?
  session                  AcademicSession @relation(fields: [session_id], references: [id])
  student                  Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  section                  Section         @relation(fields: [section_id], references: [id])
  department               Department      @relation(fields: [dept_id], references: [id])
  program                  Program         @relation(fields: [program_id], references: [id])
  branch                   Branch?         @relation(fields: [branch_id], references: [id])

  @@unique([session_id, student_id])
  @@index([session_id])
  @@index([student_id])
  @@index([section_id])
  @@index([is_current])
  @@index([semester])
  @@index([academic_year, semester])
  @@index([status])
}

// ─── Faculty ──────────────────────────────────────────────────
model Faculty {
  id                     String    @id @default(uuid())
  user_id                String    @unique
  name                   String
  first_name             String?
  last_name              String?
  emp_id                 String?   @unique
  employee_code          String?   @unique
  designation            String?
  phone                  String?
  dept_id                String?
  dob                    DateTime?
  gender                 String?
  joining_date           DateTime?
  status                 String?   @default("ACTIVE")
  deleted_at             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  photo_url              String?
  blood_group            String?
  emergency_contact      String?
  emergency_phone        String?
  emergency_relation     String?
  aadhar_no              String?
  category               String?
  pan_no                 String?
  personal_email         String?
  religion               String?
  nick_name              String?
  qualification          String?
  specialization         String?
  experience_years       Int?
  employee_type          String?
  salary_grade           String?
  salary_encrypted       String?
  bank_account_encrypted String?
  bank_name              String?
  bank_ifsc              String?
  pf_number              String?
  esi_number             String?
  is_teaching            Boolean   @default(true)
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  retirement_date        DateTime?
  resignation_date       DateTime?
  exit_reason            String?
  // Campus residence
  lives_on_campus        Boolean   @default(false)
  accommodation_type     String? // QUARTER | FLAT | HOSTEL | OUTSIDE
  campus_quarter_no      String? // quarter/room number
  campus_address         String? // full campus address
  // Subject preferences
  subject_pref_1         String? // subject_id preferred
  subject_pref_2         String? // subject_id preferred
  // RBAC role
  erp_role               String? // FACULTY | DEPT_ADMIN | EXAM_COORD | ACCOUNT | LIBRARY | LAB_INCHARGE
  biometric_device_id    String?
  // Roles — both from Role table (custom roles)
  primary_role_id        String? // main role e.g. "Faculty", "HOD", "Lab Incharge"
  secondary_role_id      String? // optional e.g. "TT Coordinator", "Exam Coordinator"
  basic_salary           Float? // Used for salary slip generation

  hod_of_departments      Department[]            @relation("DepartmentHOD")
  department              Department?             @relation(fields: [dept_id], references: [id])
  user                    User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  facultyGroups           FacultyGroupMember[]
  subjects                FacultySubject[]
  feedbackForms           FeedbackForm[]
  coordinating_sections   Section[]               @relation("SectionCoordinator")
  sectionSubjects         SectionSubject[]        @relation("SectionSubjectFaculty")
  sectionSubjectHistory   SectionSubjectHistory[]
  facultyCareerHistories  FacultyCareerHistory[]
  leaveRequests           LeaveRequest[]
  leaveApprovalFlow       LeaveApprovalFlow?
  // V3 additions
  workloads               FacultyWorkload[]
  timetableEntries        TimetableEntry[]
  substitutionsGiven      Substitution[]          @relation("OriginalFaculty")
  substitutionsTaken      Substitution[]          @relation("SubstituteFaculty")
  roomStaff               RoomStaff[]
  // Leave relations
  leavePolicy             FacultyLeavePolicy?
  leaveApprovalWorkflow   LeaveApprovalWorkflow?  @relation("FacultyApprovalWorkflow")
  leaveApps               LeaveApplication[]      @relation("FacultyLeaveApps")
  leaveApprovalSteps      LeaveApprovalStep[]     @relation("LeaveStepApprover")
  leaveSubstOriginal      LeaveSubstitution[]     @relation("SubstOriginal")
  leaveSubstFaculty       LeaveSubstitution[]     @relation("SubstFaculty")
  // Attendance
  biometricAttendance     FacultyAttendance[]
  studentAttendanceMarked StudentAttendance[]
  courseStructures        CourseStructure[]
  topicsTaught            TopicTaught[]
  facultySubjectRequests  FacultySubjectRequest[]
  // Phase 1 back-relations
  qualifications          FacultyQualification[]
  primaryRole             Role?                   @relation("FacultyPrimaryRole", fields: [primary_role_id], references: [id])
  secondaryRole           Role?                   @relation("FacultySecondaryRole", fields: [secondary_role_id], references: [id])
  assignments             Assignment[]
  questionPapers          QuestionPaper[]
  salarySlips             SalarySlip[]
  leaveBalances           LeaveBalance[]
  leaveQuotas             FacultyLeaveQuota[]

  @@index([dept_id])
  @@index([emp_id])
}

// ─── Faculty Career History ───────────────────────────────────
model FacultyCareerHistory {
  id                String    @id @default(uuid())
  faculty_id        String
  action            String
  prev_value        String?
  new_value         String?
  prev_designation  String?
  new_designation   String?
  prev_salary_grade String?
  new_salary_grade  String?
  prev_dept_id      String?
  new_dept_id       String?
  prev_status       String?
  new_status        String?
  changed_fields    String[]  @default([])
  prev_data         Json?
  new_data          Json?
  effective_date    DateTime?
  reason            String?
  documents         String[]  @default([])
  changed_by        String?
  changed_by_name   String?
  createdAt         DateTime  @default(now())
  faculty           Faculty   @relation(fields: [faculty_id], references: [id], onDelete: Cascade)

  @@index([faculty_id])
  @@index([action])
  @@index([createdAt])
}

model FacultySubject {
  id         String  @id @default(uuid())
  faculty_id String
  subject_id String
  faculty    Faculty @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([faculty_id, subject_id])
}

// ─── Faculty Leave ────────────────────────────────────────────
model LeaveRequest {
  id               String              @id @default(uuid())
  faculty_id       String
  leave_type       String
  from_date        DateTime
  to_date          DateTime
  total_days       Float
  reason           String
  documents        String[]            @default([])
  status           String              @default("PENDING")
  current_level    Int                 @default(1)
  remarks          String?
  rejection_reason String?
  cancelled_by     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  faculty          Faculty             @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  approvalSteps    LeaveApprovalStep[]

  @@index([faculty_id])
  @@index([status])
  @@index([from_date])
}

model LeaveApprovalFlow {
  id         String   @id @default(uuid())
  faculty_id String   @unique
  chain      Json     @default("[]")
  created_by String?
  updatedAt  DateTime @updatedAt
  faculty    Faculty  @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
}

// ─── UI Permissions ───────────────────────────────────────────
model UIPermission {
  id          String   @id @default(uuid())
  module      String
  action      String
  role        String?
  is_hidden   Boolean  @default(false)
  is_disabled Boolean  @default(false)
  updated_by  String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([module, action, role])
  @@index([module])
  @@index([role])
}

// ─── Special Groups ───────────────────────────────────────────
model SpecialGroup {
  id                 String                   @id @default(uuid())
  name               String
  description        String?
  type               String                   @default("OTHER")
  created_by         String?
  head_id            String?
  is_active          Boolean                  @default(true)
  deleted_at         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  members            SpecialGroupMember[]
  feedbackForms      FeedbackForm[]
  announcements      GroupAnnouncement[]
  attendanceRequests GroupAttendanceRequest[]
  tasks              GroupTask[]
  polls              GroupPoll[]
  files              GroupFile[]
  notices            GroupNotice[]
  roomBookings       GroupRoomBooking[]
}

model SpecialGroupMember {
  id         String       @id @default(uuid())
  group_id   String
  student_id String
  role       String       @default("MEMBER")
  addedAt    DateTime     @default(now())
  addedBy    String?
  group      SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([group_id, student_id])
}

model FacultyGroup {
  id          String               @id @default(uuid())
  name        String
  description String?
  type        String               @default("OTHER")
  created_by  String?
  head_id     String?
  is_active   Boolean              @default(true)
  deleted_at  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     FacultyGroupMember[]

  @@index([type])
}

model FacultyGroupMember {
  id         String       @id @default(uuid())
  group_id   String
  faculty_id String
  role       String       @default("MEMBER")
  addedAt    DateTime     @default(now())
  addedBy    String?
  faculty    Faculty      @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  group      FacultyGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, faculty_id])
  @@index([group_id])
}

// ─── Group Features ───────────────────────────────────────────
model GroupAnnouncement {
  id         String       @id @default(uuid())
  group_id   String
  posted_by  String
  title      String
  body       String
  priority   String       @default("MEDIUM")
  is_pinned  Boolean      @default(false)
  deleted_at DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  group      SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([createdAt])
}

model GroupAttendanceRequest {
  id           String       @id @default(uuid())
  group_id     String
  requested_by String
  event_name   String
  event_date   DateTime
  from_time    String?
  to_time      String?
  venue        String?
  reason       String?
  status       String       @default("PENDING")
  approved_by  String?
  approved_at  DateTime?
  remarks      String?
  createdAt    DateTime     @default(now())
  group        SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([status])
}

model GroupTask {
  id          String       @id @default(uuid())
  group_id    String
  created_by  String
  title       String
  description String?
  due_date    DateTime?
  priority    String       @default("MEDIUM")
  status      String       @default("OPEN")
  assigned_to String[]     @default([])
  deleted_at  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  group       SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([status])
}

model GroupPoll {
  id           String              @id @default(uuid())
  group_id     String
  created_by   String
  question     String
  poll_type    String              @default("SINGLE")
  ends_at      DateTime?
  is_anonymous Boolean             @default(false)
  is_active    Boolean             @default(true)
  deleted_at   DateTime?
  createdAt    DateTime            @default(now())
  group        SpecialGroup        @relation(fields: [group_id], references: [id], onDelete: Cascade)
  choices      GroupPollChoice[]
  responses    GroupPollResponse[]

  @@index([group_id])
}

model GroupPollChoice {
  id        String              @id @default(uuid())
  poll_id   String
  text      String
  order     Int                 @default(0)
  poll      GroupPoll           @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  responses GroupPollResponse[]

  @@index([poll_id])
}

model GroupPollResponse {
  id         String          @id @default(uuid())
  poll_id    String
  choice_id  String
  student_id String
  createdAt  DateTime        @default(now())
  poll       GroupPoll       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  choice     GroupPollChoice @relation(fields: [choice_id], references: [id], onDelete: Cascade)

  @@unique([poll_id, student_id, choice_id])
  @@index([poll_id])
}

model GroupFile {
  id          String       @id @default(uuid())
  group_id    String
  uploaded_by String
  file_name   String
  file_url    String
  file_size   Int?
  file_type   String?
  description String?
  deleted_at  DateTime?
  createdAt   DateTime     @default(now())
  group       SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
}

model GroupNotice {
  id             String       @id @default(uuid())
  group_id       String
  posted_by      String
  title          String
  body           String
  effective_from DateTime?
  effective_to   DateTime?
  is_mandatory   Boolean      @default(false)
  deleted_at     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  group          SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
}

model GroupRoomBooking {
  id               String       @id @default(uuid())
  group_id         String
  requested_by     String
  room_name        String
  booking_date     DateTime
  from_time        String
  to_time          String
  purpose          String
  expected_count   Int?
  status           String       @default("PENDING")
  approved_by      String?
  approved_at      DateTime?
  rejection_reason String?
  createdAt        DateTime     @default(now())
  group            SpecialGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([status])
  @@index([booking_date])
}

// ─── Curriculum ───────────────────────────────────────────────
model CurriculumSubject {
  id         String          @id @default(uuid())
  session_id String
  program_id String
  branch_id  String?
  semester   Int
  subject_id String
  type       String          @default("REGULAR")
  is_core    Boolean         @default(true)
  credits    Int?
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  session    AcademicSession @relation(fields: [session_id], references: [id])
  program    Program         @relation(fields: [program_id], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([session_id, program_id, semester, subject_id])
  @@index([session_id])
  @@index([program_id])
  @@index([program_id, semester])
}

// ─── Feedback ─────────────────────────────────────────────────
model FeedbackCategory {
  id                 String              @id @default(uuid())
  name               String
  type               String
  is_active          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  forms              FeedbackForm[]
  feedbackFormGroups FeedbackFormGroup[]
  questions          FeedbackQuestion[]
}

model FeedbackQuestion {
  id          String           @id @default(uuid())
  category_id String
  question    String
  type        String
  options     String[]
  is_required Boolean          @default(true)
  order       Int              @default(0)
  answers     FeedbackAnswer[]
  category    FeedbackCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

model FeedbackForm {
  id                  String                @id @default(uuid())
  category_id         String
  title               String
  is_active           Boolean               @default(true)
  action_taken        String?
  start_date          DateTime
  end_date            DateTime
  faculty_id          String?
  subject_id          String?
  section_id          String?
  all_students        Boolean               @default(false)
  batch_year          Int?
  program_id          String?
  department_id       String?
  group_id            String?
  specialGroupId      String?
  feedbackFormGroupId String?
  category            FeedbackCategory      @relation(fields: [category_id], references: [id])
  program             Program?              @relation(fields: [program_id], references: [id])
  department          Department?           @relation(fields: [department_id], references: [id])
  faculty             Faculty?              @relation(fields: [faculty_id], references: [id])
  feedbackFormGroup   FeedbackFormGroup?    @relation(fields: [feedbackFormGroupId], references: [id])
  section             Section?              @relation(fields: [section_id], references: [id])
  specialGroup        SpecialGroup?         @relation(fields: [specialGroupId], references: [id])
  subject             Subject?              @relation(fields: [subject_id], references: [id])
  students            FeedbackFormStudent[]
  responses           FeedbackResponse[]
}

model FeedbackFormGroup {
  id            String           @id @default(uuid())
  name          String
  description   String?
  category_id   String
  start_date    DateTime
  end_date      DateTime
  is_active     Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  feedbackForms FeedbackForm[]
  category      FeedbackCategory @relation(fields: [category_id], references: [id])

  @@index([category_id])
}

model FeedbackFormStudent {
  form_id    String
  student_id String
  form       FeedbackForm @relation(fields: [form_id], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@id([form_id, student_id])
}

model FeedbackResponse {
  id                 String           @id @default(uuid())
  form_id            String
  student_id         String
  submittedAt        DateTime         @default(now())
  snap_academic_year String?
  snap_batch         String?
  snap_program_name  String?
  snap_branch_name   String?
  snap_dept_name     String?
  snap_section_name  String?
  snap_semester      Int?
  answers            FeedbackAnswer[]
  form               FeedbackForm     @relation(fields: [form_id], references: [id], onDelete: Cascade)
  student            Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([form_id, student_id])
}

model FeedbackAnswer {
  id          String           @id @default(uuid())
  response_id String
  question_id String
  answer_text String?
  rating      Int?
  selected    String?
  question    FeedbackQuestion @relation(fields: [question_id], references: [id])
  response    FeedbackResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)

  @@unique([response_id, question_id])
}

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  type       NotificationType
  title      String
  message    String
  is_read    Boolean          @default(false)
  data       Json?
  created_at DateTime         @default(now())
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
}

model AuditLog {
  id             String    @id @default(uuid())
  user_id        String?
  user_email     String?
  user_role      String?
  action         String
  module         String
  record_id      String?
  record_label   String?
  prev_data      Json?
  new_data       Json?
  changed_fields String[]
  ip             String?
  user_agent     String?
  reversible     Boolean   @default(false)
  restored_at    DateTime?
  restored_by    String?
  createdAt      DateTime  @default(now())
  user           User?     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([module, record_id])
  @@index([action])
  @@index([createdAt])
}

enum NotificationType {
  NEW_FEEDBACK_FORM
  PROMOTION
  DEMOTION
  SECTION_CHANGE
  FORM_CLOSED
  GENERAL
  ACCOUNT_BLOCKED
  ACCOUNT_UNBLOCKED
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  GROUP_ANNOUNCEMENT
  GROUP_TASK
  GROUP_POLL
  GROUP_NOTICE
  STATUS_CHANGED
}

model OtpToken {
  id         String   @id @default(uuid())
  user_id    String
  purpose    String
  otp_hash   String
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  expires_at DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@index([expires_at])
}

model ErpSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  label       String
  description String?
  category    String
  data_type   String   @default("string")
  is_system   Boolean  @default(false)
  updated_by  String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
}

model UserTotp {
  id         String   @id @default(uuid())
  user_id    String   @unique
  secret     String
  is_enabled Boolean  @default(false)
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ─── Academic Calendar Periods ────────────────────────────────
model AcademicPeriod {
  id         String          @id @default(uuid())
  session_id String
  type       String          @default("ACADEMIC")
  label      String
  start_date DateTime
  end_date   DateTime
  order      Int             @default(0)
  notes      String?
