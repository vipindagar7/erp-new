  enrollment_id     String?
  student_id        String
  section_id        String?
  session_id        String?
  action            String
  from_semester     Int?
  to_semester       Int?
  from_status       String?
  to_status         String?
  from_section_id   String?
  to_section_id     String?
  from_section_code String?
  to_section_code   String?
