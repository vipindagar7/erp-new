// ─────────────────────────────────────────────────────────────
// ACADEMIC CALENDAR
// ─────────────────────────────────────────────────────────────

model AcademicCalendarEvent {
  id                 String            @id @default(uuid())
  session_id         String
  title              String
  event_type         CalendarEventType
  start_date         DateTime          @db.Date
  end_date           DateTime          @db.Date
  week_no            Int?
  is_holiday         Boolean           @default(false)
  is_working         Boolean           @default(true)
  affects_attendance Boolean           @default(true)
  color              String? // hex color for UI
  description        String?
  dept_ids           String[]          @default([]) // [] = all depts
  created_by         String?
  deleted_at         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  session AcademicSession @relation(fields: [session_id], references: [id])

  @@index([session_id, start_date])
  @@index([event_type])
  @@index([is_holiday])
}

// ─────────────────────────────────────────────────────────────
// EXTRA ATTENDANCE
// ─────────────────────────────────────────────────────────────

model ExtraAttendance {
  id             String   @id @default(uuid())
  student_id     String
  section_id     String?
  subject_id     String?
  session_id     String
  units          Int // number of extra classes
  reason         String
  type           String   @default("EXTRA") // EXTRA | MEDICAL | EVENT
  granted_by     String
  granted_at     DateTime @default(now())
  effective_date DateTime @db.Date
  approved       Boolean  @default(true)
  remarks        String?

  student Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [session_id], references: [id])

  @@index([student_id])
  @@index([session_id])
  @@index([section_id])
}

// ─────────────────────────────────────────────────────────────
// STUDENT LEAVE — ENHANCED (approval workflow)
// ─────────────────────────────────────────────────────────────

model StudentLeaveApproval {
  id          String              @id @default(uuid())
  leave_id    String
  step        Int // 1=CC, 2=HOD, 3=Director
  role        String // CLASS_COORDINATOR | HOD | DIRECTOR
  approver_id String? // faculty/admin user id
  status      LeaveApprovalStatus @default(PENDING)
  remarks     String?
  acted_at    DateTime?
  createdAt   DateTime            @default(now())

  leave StudentLeave @relation(fields: [leave_id], references: [id], onDelete: Cascade)

  @@index([leave_id])
  @@index([approver_id, status])
}

// ─────────────────────────────────────────────────────────────
// ASSIGNMENT MODULE
// ─────────────────────────────────────────────────────────────

model Assignment {
  id                   String    @id @default(uuid())
  title                String
  description          String?
  instructions         String?
  subject_id           String
  faculty_id           String
  session_id           String
  // Sections this assignment is for
  section_ids          String[]  @default([])
  // Marks
  total_marks          Float     @default(10)
  passing_marks        Float     @default(4)
  // Deadline
  deadline             DateTime
  allow_late           Boolean   @default(true)
  late_penalty_pct     Float     @default(5) // % per day
  max_late_days        Int       @default(3)
  // Submission type
  allow_file           Boolean   @default(true)
  allow_text           Boolean   @default(true)
  max_file_size_mb     Int       @default(20)
  allowed_formats      String[]  @default(["pdf", "doc", "docx", "zip"])
  // Plagiarism
  plagiarism_check     Boolean   @default(false)
  plagiarism_threshold Float     @default(30) // % threshold to flag
  // Status
  status               String    @default("DRAFT") // DRAFT|PUBLISHED|CLOSED|GRADED
  published_at         DateTime?
  closed_at            DateTime?
  // CO-PO mapping
  co_mapping           String[]  @default([])
  po_mapping           String[]  @default([])
  // Meta
  created_by           String?
  deleted_at           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  subject     Subject                @relation(fields: [subject_id], references: [id])
  faculty     Faculty                @relation(fields: [faculty_id], references: [id])
  session     AcademicSession        @relation(fields: [session_id], references: [id])
  submissions AssignmentSubmission[]
  grades      AssignmentGrade[]

  @@index([faculty_id])
  @@index([subject_id])
  @@index([session_id])
  @@index([status])
  @@index([deadline])
}

model AssignmentSubmission {
  id              String           @id @default(uuid())
  assignment_id   String
  student_id      String
  status          SubmissionStatus @default(DRAFT)
  // Content
  text_content    String?
  file_urls       String[]         @default([])
  file_names      String[]         @default([])
  // Timing
  submitted_at    DateTime?
  is_late         Boolean          @default(false)
  late_days       Int              @default(0)
  // Plagiarism
  similarity_pct  Float?
  plagiarism_flag Boolean          @default(false)
  checked_at      DateTime?
  // Grading
  obtained_marks  Float?
  penalty_marks   Float            @default(0)
  final_marks     Float?
  graded_at       DateTime?
  graded_by       String?
  grade_remarks   String?
  justify_reason  String? // if giving full marks despite penalty
  // Meta
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignment Assignment       @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  grade      AssignmentGrade?

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
  @@index([status])
}

model AssignmentGrade {
  id            String   @id @default(uuid())
  assignment_id String
  submission_id String   @unique
  student_id    String
  marks         Float
  letter_grade  String?
  remarks       String?
  graded_by     String
  graded_at     DateTime @default(now())

  assignment Assignment           @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  submission AssignmentSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  student    Student              @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([assignment_id])
  @@index([student_id])
}

// ─────────────────────────────────────────────────────────────
// EXAM MODULE
// ─────────────────────────────────────────────────────────────

model Exam {
  id                  String     @id @default(uuid())
  session_id          String
  title               String
  code                String?
  exam_type           ExamType
  status              ExamStatus @default(DRAFT)
  dept_ids            String[]   @default([]) // [] = all
  // Schedule
  start_date          DateTime   @db.Date
  end_date            DateTime   @db.Date
  // Settings
  seating_auto        Boolean    @default(true)
  hall_ticket_enabled Boolean    @default(true)
  result_published    Boolean    @default(false)
  result_published_at DateTime?
  // Instructions
  instructions        String?
  // Meta
  created_by          String?
  cancelled_by        String?
  cancelled_at        DateTime?
  cancel_reason       String?
  deleted_at          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  session        AcademicSession @relation(fields: [session_id], references: [id])
  schedule       ExamSchedule[]
  rooms          ExamRoom[]
  seatings       ExamSeating[]
  hallTickets    HallTicket[]
  questionPapers QuestionPaper[]
  marks          ExamMark[]

  @@index([session_id, exam_type])
  @@index([status])
  @@index([start_date])
}

model ExamSchedule {
  id            String   @id @default(uuid())
  exam_id       String
  subject_id    String
  branch_ids    String[] @default([])
  section_ids   String[] @default([])
  exam_date     DateTime @db.Date
  start_time    String // "10:00"
  end_time      String // "13:00"
  duration_mins Int      @default(180)
  max_marks     Float    @default(100)
  passing_marks Float    @default(40)
  // CO-PO
  co_mapping    String[] @default([])
  is_practical  Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id])

  @@index([exam_id])
  @@index([subject_id])
  @@index([exam_date])
}

model ExamRoom {
  id              String   @id @default(uuid())
  exam_id         String
  exam_date       DateTime @db.Date
  room_id         String
  capacity        Int
  invigilator_ids String[] @default([])
  notes           String?

  exam     Exam          @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  room     Room          @relation(fields: [room_id], references: [id])
  seatings ExamSeating[]

  @@index([exam_id, exam_date])
}

model ExamSeating {
  id           String   @id @default(uuid())
  exam_id      String
  exam_room_id String
  student_id   String
  roll_no      String?
  seat_no      String
  exam_date    DateTime @db.Date
  subject_id   String?
  row_no       Int?
  col_no       Int?
  is_manual    Boolean  @default(false) // admin override
  createdAt    DateTime @default(now())

  exam      Exam     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  exam_room ExamRoom @relation(fields: [exam_room_id], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, student_id, exam_date])
  @@unique([exam_room_id, seat_no, exam_date])
  @@index([exam_id])
  @@index([student_id])
}

model HallTicket {
  id                 String    @id @default(uuid())
  exam_id            String
  student_id         String
  ticket_no          String    @unique
  generated_at       DateTime  @default(now())
  generated_by       String?
  is_valid           Boolean   @default(true)
  invalidated_reason String?
  downloaded_at      DateTime?
  pdf_url            String?

  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, student_id])
  @@index([exam_id])
  @@index([student_id])
}

model QuestionPaper {
  id           String    @id @default(uuid())
  exam_id      String
  subject_id   String
  faculty_id   String
  title        String
  // Content
  file_url     String?
  text_content String?
  format_type  String    @default("STANDARD") // STANDARD|CUSTOM
  // CO-PO mapping
  co_mapping   Json?
  po_mapping   Json?
  // Status
  status       String    @default("DRAFT") // DRAFT|SUBMITTED|APPROVED|PUBLISHED
  submitted_at DateTime?
  approved_by  String?
  approved_at  DateTime?
  // Print settings (from admin template)
  include_logo Boolean   @default(true)
  header_html  String?
  // Meta
  deleted_at   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id])
  faculty Faculty @relation(fields: [faculty_id], references: [id])

  @@index([exam_id, subject_id])
  @@index([faculty_id])
}

model ExamMark {
  id               String    @id @default(uuid())
  exam_id          String
  student_id       String
  subject_id       String
  exam_type        ExamType
  marks_obtained   Float
  max_marks        Float
  is_absent        Boolean   @default(false)
  is_withheld      Boolean   @default(false)
  remarks          String?
  entered_by       String?
  verified_by      String?
  verified_at      DateTime?
  result_published Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id])

  @@unique([exam_id, student_id, subject_id])
  @@index([exam_id])
  @@index([student_id])
  @@index([subject_id])
}

// ─────────────────────────────────────────────────────────────
// STUDENT FEE MODULE
// ─────────────────────────────────────────────────────────────

model FeeStructure {
  id           String   @id @default(uuid())
  session_id   String
  program_id   String?
  branch_id    String?
  semester     Int? // null = all semesters
  title        String
  total_amount Float
  installments Int      @default(1)
  // Components breakdown
  components   Json // { "tuition": 60000, "development": 15000, ... }
  // Meta
  created_by   String?
  is_active    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session  AcademicSession @relation(fields: [session_id], references: [id])
  payments FeePayment[]

  @@index([session_id])
  @@index([program_id])
  @@index([branch_id])
}

model Scholarship {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  type        String // MERIT|SPORTS|SC_ST|MINORITY|GOVT|INSTITUTE
  amount_type String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  amount      Float // % or fixed ₹
  max_amount  Float?
  eligibility String?
  session_id  String?
  is_active   Boolean  @default(true)
  created_by  String?
  createdAt   DateTime @default(now())

  payments FeePayment[]

  @@index([type])
  @@index([is_active])
}

model FeePayment {
  id                   String    @id @default(uuid())
  student_id           String
  fee_structure_id     String?
  session_id           String
  // Amount
  total_amount         Float
  paid_amount          Float     @default(0)
  due_amount           Float
  status               FeeStatus @default(PENDING)
  // Installments
  installment_no       Int       @default(1)
  installment_due_date DateTime? @db.Date
  // Payment details (manual entry)
  payment_date         DateTime? @db.Date
  payment_mode         String? // CASH|DD|NEFT|CHEQUE
  receipt_no           String?
  transaction_ref      String?
  bank_ref             String?
  // Scholarship/waiver
  scholarship_id       String?
  waiver_amount        Float     @default(0)
  waiver_reason        String?
  // Admin
  received_by          String?
  verified_by          String?
  verified_at          DateTime?
  remarks              String?
  receipt_url          String? // PDF receipt URL
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student       Student         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  fee_structure FeeStructure?   @relation(fields: [fee_structure_id], references: [id])
  session       AcademicSession @relation(fields: [session_id], references: [id])
  scholarship   Scholarship?    @relation(fields: [scholarship_id], references: [id])

  @@index([student_id])
  @@index([session_id])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// HR / SALARY MODULE
// ─────────────────────────────────────────────────────────────

model SalaryComponent {
  id           String   @id @default(uuid())
  name         String // "Basic", "HRA", "DA", "PF", "TDS"
  code         String   @unique // "BASIC", "HRA", "DA", "PF", "ESI", "TDS", "PT"
  type         String // EARNING | DEDUCTION | STATUTORY
  calc_type    String   @default("FIXED") // FIXED | PERCENTAGE_OF_BASIC | PERCENTAGE_OF_GROSS
  value        Float // amount or percentage
  is_taxable   Boolean  @default(false)
  is_statutory Boolean  @default(false) // PF, ESI, TDS, PT
  is_active    Boolean  @default(true)
  sort_order   Int      @default(0)
  description  String?
  created_by   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  slipComponents SalarySlipComponent[]

  @@index([type, is_active])
}

model SalarySlip {
  id               String       @id @default(uuid())
  faculty_id       String
  cycle_id         String? // optional link to SalaryCycle
  month            Int // 1-12
  year             Int
  status           SalaryStatus @default(DRAFT)
  // Summary
  gross_salary     Float
  total_deductions Float
  net_salary       Float
  working_days     Int
  present_days     Int
  lop_days         Int          @default(0) // Loss of pay days
  // Approval
  generated_by     String?
  generated_at     DateTime?
  approved_by      String?
  approved_at      DateTime?
  paid_by          String?
  paid_at          DateTime?
  // PDF
  pdf_url          String?
  remarks          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cycle      SalaryCycle?          @relation(fields: [cycle_id], references: [id])
  faculty    Faculty               @relation(fields: [faculty_id], references: [id], onDelete: Cascade)
  components SalarySlipComponent[]

  @@unique([faculty_id, month, year])
  @@index([faculty_id])
  @@index([month, year])
  @@index([status])
}

model SalarySlipComponent {
  id           String  @id @default(uuid())
  slip_id      String
  component_id String
  amount       Float
  is_earning   Boolean

  slip      SalarySlip      @relation(fields: [slip_id], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [component_id], references: [id])

  @@unique([slip_id, component_id])
}

// ─────────────────────────────────────────────────────────────
// TRAINING — STUDENT SKILL CARD
// ─────────────────────────────────────────────────────────────

model StudentSkillCard {
  id                     String    @id @default(uuid())
  student_id             String    @unique
  branch_id              String?
  program_id             String?
  domain_track           String? // student's chosen domain track
  batch_year             Int?
  // Summary (computed)
  total_entries          Int       @default(0)
  completed_entries      Int       @default(0)
  // Placement readiness
  readiness_level        String? // FOUNDATIONAL | JOB_READY | PLACEMENT_READY
  domain_track_completed Boolean   @default(false)
  placement_score        Float?
  domain_rank            Int?
  // Meta
  issued_at              DateTime?
  last_updated           DateTime  @default(now())
  issued_by              String?
  pdf_url                String?

  student Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  entries SkillCardEntry[]

  @@index([student_id])
  @@index([branch_id])
}

model SkillCardEntry {
  id              String    @id @default(uuid())
  skill_card_id   String
  student_id      String
  // Location in card
  year_no         Int // 1-4
  semester_no     Int // 1-8
  entry_no        Int // row number
  // Training details
  training_id     String? // link to Training if institute training
  course_name     String
  provider        String
  duration        String? // "30 hrs", "1 Day", "Self-paced"
  course_url      String?
  type            String    @default("SELF_LEARNING") // INSTITUTE_OFFLINE | COMPANY_WORKSHOP | SELF_LEARNING
  // Completion
  is_completed    Boolean   @default(false)
  completion_date DateTime? @db.Date
  certificate_url String?
  // Verification
  is_verified     Boolean   @default(false)
  verified_by     String? // mentor/admin who verified
  verified_at     DateTime?
  verified_sign   String?
  // CO-PO
  co_mapping      String[]  @default([])
  // Meta
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  skill_card StudentSkillCard @relation(fields: [skill_card_id], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([skill_card_id])
  @@index([student_id, year_no, semester_no])
  @@index([is_completed])
  @@index([is_verified])
}

// ─────────────────────────────────────────────────────────────
// TRAINING — add missing TrainingEnrollment relations
// (Already added in training_schema_addition.prisma)
// These patch the Student model relations
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// DEPT-SCOPED ADMIN PERMISSIONS
// ─────────────────────────────────────────────────────────────

model AdminDeptScope {
  id         String   @id @default(uuid())
  user_id    String
  dept_id    String
  role       String   @default("DEPT_ADMIN") // DEPT_ADMIN | MODULE_HEAD
  modules    String[] @default([]) // [] = all modules, or ["students","faculty"]
  granted_by String?
  is_active  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dept Department @relation(fields: [dept_id], references: [id])

  @@unique([user_id, dept_id])
  @@index([user_id])
  @@index([dept_id])
}

// ─────────────────────────────────────────────────────────────
// BACK-RELATIONS TO PATCH ON EXISTING MODELS
// Add these lines to respective models in schema.prisma:
//
// Student:
